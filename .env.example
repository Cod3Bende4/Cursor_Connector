# ─────────────────────────────────────────────
# Cursor Telegram Bridge — Environment Config
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Telegram ──────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID (get it from @userinfobot)
TELEGRAM_ALLOWED_CHAT_ID=your_chat_id_here

# ── Cursor ────────────────────────────────────
# Exact app name as it appears in macOS (check Activity Monitor)
CURSOR_APP_NAME=Cursor

# ── Projects ──────────────────────────────────
# Path to your projects registry JSON file
PROJECTS_CONFIG_PATH=./projects.json

# Default project to activate on startup
DEFAULT_PROJECT_NAME=my-project

# ── Response Capture ──────────────────────────
# Temp file where Cursor AI appends responses (Strategy B)
OUTPUT_WATCH_FILE=/tmp/cursor-bridge-output.txt

# How long to wait for a response before timing out (ms)
RESPONSE_TIMEOUT_MS=60000

# ── Polling ───────────────────────────────────
# How often to poll for context/mode changes (ms)
POLLING_INTERVAL_MS=1500

# ── Context % (status widget) ───────────────
# Bridge estimates usage from Telegram↔Cursor traffic; divisor for “% of window”
CONTEXT_WINDOW_TOKENS_ESTIMATE=100000
# Set true to try reading usage from Cursor’s UI (often blank in Electron)
CONTEXT_FROM_CURSOR_UI=false

# ── New chat (Command Palette) ────────────────
# Prefer the command id (unique). “New Chat” often selects the wrong palette row.
NEW_CHAT_PALETTE_QUERY=aichat.newchataction
# Optional: fallback ids if the first run errors (comma or pipe separated)
# NEW_CHAT_PALETTE_ALTERNATES=workbench.action.chat.newChat
# Cmd+L to focus AI chat before opening palette (recommended)
NEW_CHAT_FOCUS_CHAT_FIRST=true

# ── Model picker (/setmodel) ──────────────────
# Optional alias file (copy models.json.example)
MODELS_CONFIG_PATH=./models.json
# Opens picker with Cmd+/ (Cursor default on macOS)
MODEL_PICKER_OPEN=slash

# ── Progress (while waiting for Cursor) ──────
# Set to false to keep a static “Waiting…” line only
PROGRESS_UPDATES=true
# How often to refresh that line (ms); min ~2000 to avoid Telegram rate limits
PROGRESS_UPDATE_INTERVAL_MS=3500

# ── Logging ───────────────────────────────────
# Levels: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
