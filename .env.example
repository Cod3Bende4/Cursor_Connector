# ─────────────────────────────────────────────
# Cursor Telegram Bridge — Environment Config
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Telegram ──────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID (get it from @userinfobot)
TELEGRAM_ALLOWED_CHAT_ID=your_chat_id_here

# ── Cursor ────────────────────────────────────
# Exact app name as it appears in macOS (check Activity Monitor)
CURSOR_APP_NAME=Cursor

# ── Projects ──────────────────────────────────
# Path to your projects registry JSON file
PROJECTS_CONFIG_PATH=./projects.json

# Default project to activate on startup
DEFAULT_PROJECT_NAME=my-project

# ── Response Capture ──────────────────────────
# Temp file where Cursor AI appends responses (Strategy B)
OUTPUT_WATCH_FILE=/tmp/cursor-bridge-output.txt

# How long to wait for a response before timing out (ms)
RESPONSE_TIMEOUT_MS=60000

# ── Polling ───────────────────────────────────
# How often to poll for context/mode changes (ms)
POLLING_INTERVAL_MS=1500

# ── Logging ───────────────────────────────────
# Levels: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
